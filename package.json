{
  "name": "brokeriq",
  "version": "2.0.0",
  "private": true,
  "description": "BrokerIQ — Gurgaon property brokerage hub: marketplace website, broker CRM & lead automation, super admin",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint apps/api/src apps/api/test apps/web/src apps/mobile/app apps/mobile/src packages/shared/src && turbo run typecheck",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
