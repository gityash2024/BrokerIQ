{
  "name": "@brokeriq/api",
  "version": "2.0.0",
  "private": true,
  "description": "BrokerIQ REST + realtime API (NestJS, Prisma, PostgreSQL)",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/src/main.js",
    "start:prod": "prisma migrate deploy && node dist/prisma/seed.js && node dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js --runInBand src",
    "test:e2e": "jest --config jest.config.js --runInBand",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@brokeriq/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.1",
    "csv-parse": "^6.1.0",
    "express": "^5.2.1",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "imapflow": "^1.0.195",
    "mailparser": "^3.7.4",
    "nodemailer": "^7.0.6",
    "opentype.js": "^1.3.4",
    "pdfkit": "^0.17.2",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/opentype.js": "^1.3.10",
    "@types/pdfkit": "^0.17.2",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
