// BrokerIQ — Gurgaon brokerage hub
// PostgreSQL schema. All timestamps UTC. Money in INR (Float rupees) unless noted (Payment.amount is paise).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ============================================================ Enums

enum Role {
  SUPER_ADMIN
  /**
   * BrokerIQ staff: listings, reviews and reports moderation.
   */
  MODERATOR
  /**
   * BrokerIQ staff: users, brokers and support tickets (limited actions).
   */
