  NO_ANSWER
  BUSY
  SWITCHED_OFF
  WRONG_NUMBER
  CALLBACK
}

enum FollowUpType {
  CALL
  WHATSAPP
  MEETING
  EMAIL
  OTHER
}

enum FollowUpStatus {
