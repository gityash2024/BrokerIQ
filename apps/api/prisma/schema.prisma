// BrokerIQ — Gurgaon brokerage hub
// PostgreSQL schema. All timestamps UTC. Money in INR (Float rupees) unless noted (Payment.amount is paise).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ============================================================ Enums

enum Role {
  SUPER_ADMIN
  BROKER_ADMIN
  BROKER_AGENT
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ListingPurpose {
  SALE
  RENT
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  PLOT
}

enum PropertyType {
  APARTMENT
  BUILDER_FLOOR
  INDEPENDENT_HOUSE
  VILLA
  PENTHOUSE
  STUDIO
  SERVICE_APARTMENT
  PG
  RESIDENTIAL_PLOT
  COMMERCIAL_PLOT
  OFFICE
  COWORKING
  SHOP
  SHOWROOM
  WAREHOUSE
  INDUSTRIAL
}

enum BrokerageType {
  NONE
  DAYS_15
  MONTH_1
  FIXED
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PossessionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
}

enum Facing {
  NORTH
  SOUTH
  EAST
  WEST
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_WEST
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  SOLD
  RENTED
  EXPIRED
  ARCHIVED
}

enum PostedByType {
  OWNER
  BROKER
  BUILDER
}

enum MediaKind {
  PHOTO
  VIDEO
  FLOOR_PLAN
}

enum EnquiryStatus {
  NEW
  RESPONDED
  CLOSED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum ReportReason {
  FAKE
  WRONG_PRICE
  ALREADY_SOLD
  BROKER_AS_OWNER
  SPAM
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum KycDocType {
  AADHAAR
  PAN
  RERA_CERTIFICATE
  GST_CERTIFICATE
  OWNERSHIP_PROOF
  ELECTRICITY_BILL
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  INTERESTED
  SITE_VISIT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  MICROSITE
  HOUSING
  ACRES99
  MAGICBRICKS
  NOBROKER
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  WEBHOOK
  CSV_IMPORT
  WALK_IN
  REFERRAL
  CALL
  MANUAL
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum ActivityType {
  NOTE
  CALL
  WHATSAPP
  EMAIL
  SMS
  STAGE_CHANGE
  ASSIGNMENT
  SITE_VISIT
  FOLLOW_UP
  PROPERTY_SHARED
  ENQUIRY
  AUTOMATION
  SYSTEM
}

enum CallOutcome {
