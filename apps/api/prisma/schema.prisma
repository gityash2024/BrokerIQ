  slug            String    @unique
  title           String
  excerpt         String?
  content         String
  coverUrl        String?
  tags            String[]
  isPublished     Boolean   @default(true)
  publishedAt     DateTime?
  authorId        String?
  metaTitle       String?
  metaDescription String?
  views           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  category  String  @default("general")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Template {
  id        String          @id @default(cuid())
  key       String          @unique
  channel   TemplateChannel
  name      String
  subject   String?
  body      String
  isActive  Boolean         @default(true)
  updatedAt DateTime        @updatedAt
}

model ContactMessage {
  id        String       @id @default(cuid())
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  status    TicketStatus @default(OPEN)
  note      String?
  userId    String?
  createdAt DateTime     @default(now())
}

model Broadcast {
  id          String   @id @default(cuid())
  audience    String
  channel     String
  title       String
  body        String
  link        String?
  sentCount   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
}

// ============================================================ Platform

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String?
  link      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorRole      String?
  organizationId String?
  action         String
  entity         String?
  entityId       String?
  meta           Json?
  ip             String?
  createdAt      DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// ============================================================ Feedback & roadmap

enum FeedbackType {
  BUG
  FEATURE
  IMPROVEMENT
  COMPLAINT
  GENERAL
}

enum FeedbackStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
}

model Feedback {
  id           String         @id @default(cuid())
  userId       String?
  type         FeedbackType   @default(GENERAL)
  title        String
  description  String
  screenshots  String[]
  rating       Int?
  platform     String         @default("WEB")
  appVersion   String?
  pageUrl      String?
  contactEmail String?
  status       FeedbackStatus @default(OPEN)
  isPublic     Boolean        @default(false)
  voteCount    Int            @default(0)
  adminReply   String?
  mergedIntoId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  votes    FeedbackVote[]
  comments FeedbackComment[]

  @@index([status, isPublic])
  @@index([userId])
}

model FeedbackVote {
  feedbackId String
  userId     String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@id([feedbackId, userId])
}

model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String?
  authorName String
  isAdmin    Boolean  @default(false)
  body       String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
}

// ------------------------------------------------------------------ growth: co-broking, requirements, owners, calls, invoices

/// A broker asks the listing's firm to work its property for a client (commission split).
model CoBrokeRequest {
  id              String        @id @default(cuid())
  listingId       String
  ownerOrgId      String
  requesterOrgId  String
  requesterUserId String
  leadId          String?
  sharePct        Float         @default(50)
  message         String?
  status          CoBrokeStatus @default(PENDING)
  respondedAt     DateTime?
  respondedById   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ownerOrg  Organization @relation("CoBrokeOwner", fields: [ownerOrgId], references: [id], onDelete: Cascade)
  requester Organization @relation("CoBrokeRequester", fields: [requesterOrgId], references: [id], onDelete: Cascade)
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deals     Deal[]

  @@unique([listingId, requesterOrgId])
  @@index([ownerOrgId, status])
  @@index([requesterOrgId, status])
}

/// A tenant's stated need ("2 BHK, Sector 54, ₹40k"): matched against every new listing.
model TenantRequirement {
  id               String            @id @default(cuid())
  userId           String
  name             String
  phone            String
  bedrooms         Int[]
  minBudget        Float?
  maxBudget        Float?
  localityIds      String[]
  furnishing       Furnishing?
  propertyTypes    PropertyType[]
  moveInBy         DateTime?
  officeHub        String?
  notes            String?
  shareWithBrokers Boolean           @default(true)
  sharedOrgIds     String[]
  status           RequirementStatus @default(ACTIVE)
  lastMatchedAt    DateTime?
  matchCount       Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([userId])
}

/// Property owners a firm works with (landlord CRM).
model Owner {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String
  email          String?
  notes          String?
  tags           String[]
  /// Secret for the owner's read-only report page (/o/<token>); null = no link shared yet
  reportToken    String?  @unique
  /// Email the owner a weekly report (needs email + SMTP)
  weeklyReport   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listings     Listing[]
  tenancies    Tenancy[]

  @@unique([organizationId, phone])
}

/// A lease the firm closed — drives renewal / re-rent reminders before it ends.
model Tenancy {
  id             String        @id @default(cuid())
  organizationId String
  listingId      String?
  ownerId        String?
  dealId         String?
  tenantName     String
  tenantPhone    String?
  rent           Float
  startDate      DateTime
  endDate        DateTime
  status         TenancyStatus @default(ACTIVE)
  remindersSent  Int[]
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  owner        Owner?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, endDate])
}

/// Click-to-call / incoming call via the firm's Exotel account.
model Call {
  id             String    @id @default(cuid())
  organizationId String
  leadId         String?
  agentId        String?
  direction      String
  fromNumber     String?
  toNumber       String?
  exoPhone       String?
  externalSid    String?   @unique
  status         String    @default("queued")
  durationSec    Int?
  recordingUrl   String?
  source         String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, startedAt])
}

/// Brokerage invoice a firm sends its client; paid via the firm's own UPI (no gateway).
model ClientInvoice {
  id             String        @id @default(cuid())
  organizationId String
  dealId         String?
  leadId         String?
  number         String
  clientName     String
  clientPhone    String?
  clientEmail    String?
  items          Json
  subtotal       Float
  gstPct         Float         @default(0)
  total          Float
  dueDate        DateTime?
  status         InvoiceStatus @default(SENT)
  paidAt         DateTime?
  paidMode       String?
  paidRef        String?
  publicToken    String        @unique
  remindersSent  Int           @default(0)
  lastReminderAt DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

// ------------------------------------------------------------------ growth: tenant trust

/// Resident review of a locality / society (moderated by Super Admin before it shows).
model LocalityReview {
  id           String               @id @default(cuid())
  localityId   String
  societyName  String?
  userId       String
  water        Int
  power        Int
  safety       Int
  parking      Int
  connectivity Int
  maintenance  Int
  pros         String?
  cons         String?
  isResident   Boolean              @default(true)
  livedYears   Int?
  status       LocalityReviewStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  locality Locality @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@unique([localityId, userId, societyName])
  @@index([localityId, status])
}

/// Token / advance a tenant paid the broker outside BrokerIQ; recorded here, never processed.
model TokenPayment {
  id             String      @id @default(cuid())
  listingId      String
  organizationId String?
  leadId         String?
  userId         String?
  amount         Float
  mode           String      @default("UPI")
  ref            String?
  status         TokenStatus @default(CLAIMED)
  markedById     String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([userId])
}

/// Geo-tagged photo taken on site by the BrokerIQ team for the "Visit verified" badge.
model ListingVerificationPhoto {
  id        String   @id @default(cuid())
  listingId String
  url       String
  lat       Float
  lng       Float
  distanceM Int
  takenById String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

// ------------------------------------------------------------------ growth: community & services

/// Someone looking for a flatmate or a room to share; phone shared only after both accept.
model FlatmateProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  lookingFor  String
  gender      String
  prefGender  String    @default("ANY")
  age         Int?
  budgetMin   Float?
  budgetMax   Float?
  localityIds String[]
  officeHub   String?
  food        String    @default("ANY")
  smoking     Boolean   @default(false)
  drinking    Boolean   @default(false)
  pets        Boolean   @default(false)
  moveInBy    DateTime?
  occupation  String?
  about       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
}

model FlatmateConnect {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  message    String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

/// Draft 11-month rent agreement generated as a PDF (not legal advice).
model RentAgreement {
  id              String   @id @default(cuid())
  createdById     String
  organizationId  String?
  listingId       String?
  landlordName    String
  landlordAddress String?
  landlordPhone   String?
  tenantName      String
  tenantAddress   String?
  tenantPhone     String?
  propertyAddress String
  rent            Float
  deposit         Float
  maintenance     Float?
  startDate       DateTime
  months          Int      @default(11)
  lockInMonths    Int      @default(0)
  noticeMonths    Int      @default(1)
  escalationPct   Float    @default(0)
  furnishing      String?
  extraClauses    String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdById])
}

/// Move-in service partners managed by Super Admin (packers, furniture rental, broadband, cleaning).
model ServicePartner {
  id          String   @id @default(cuid())
  category    String
  name        String
  logoUrl     String?
  description String?
  offer       String?
  phone       String?
  email       String?
  website     String?
  localityIds String[]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests ServiceRequest[]

  @@index([category, isActive])
}

model ServiceRequest {
  id            String    @id @default(cuid())
  partnerId     String
  userId        String
  listingId     String?
  name          String
  phone         String
  preferredDate DateTime?
  notes         String?
  status        String    @default("NEW")
  createdAt     DateTime  @default(now())

  partner ServicePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
}

/// WhatsApp-bot users (no BrokerIQ account needed) who asked for listing alerts.
model WhatsAppSubscriber {
  id             String    @id @default(cuid())
  phone          String    @unique
  userId         String?
  filters        Json
  label          String?
  active         Boolean   @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ------------------------------------------------------------------ monitoring
enum ErrorSource {
  API
  WEB
  MOBILE
}

/**
 * Grouped runtime errors (API 5xx, web/app crashes). Same fingerprint = same row with a counter.
 */
model ErrorLog {
  id          String      @id @default(cuid())
  fingerprint String      @unique
  source      ErrorSource
  message     String
  stack       String?
  route       String?
  method      String?
  userId      String?
  appVersion  String?
  userAgent   String?
  count       Int         @default(1)
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  alertedAt   DateTime?
  resolvedAt  DateTime?

  @@index([resolvedAt, lastSeenAt])
}

// ------------------------------------------------------------------ blocklist
enum BlockKind {
  EMAIL
  PHONE
  DOMAIN
  IP
}

/**
 * Banned identities: checked on signup, OTP/login, enquiries and contact reveal.
 */
model Blocklist {
  id          String    @id @default(cuid())
  kind        BlockKind
  value       String
  reason      String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@unique([kind, value])
}

// ---------------------------------------------------------------- broker growth tools (v4)

enum CampaignStatus {
  DRAFT
  RUNNING
  DONE
  CANCELLED
}

enum CampaignChannel {
  WHATSAPP
  EMAIL
  BOTH
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Broadcast to a segment of the firm's own leads, through the firm's own WhatsApp number (cost is the firm's) and/or email.
model Campaign {
  id               String          @id @default(cuid())
  organizationId   String
  createdById      String?
  name             String
  channel          CampaignChannel @default(WHATSAPP)
  /// { stages?, sources?, tags?, temperatures?, bedrooms?, localityIds?, minBudget?, maxBudget?, activeWithinDays? }
  segment          Json
  templateName     String?
  templateLanguage String?
  /// Template body params; "{name}" is replaced with the lead's first name
  params           String[]
  emailSubject     String?
  emailBody        String?
  status           CampaignStatus  @default(DRAFT)
  startedAt        DateTime?
  finishedAt       DateTime?
  total            Int             @default(0)
  sent             Int             @default(0)
  failed           Int             @default(0)
  skipped          Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients   CampaignRecipient[]

  @@index([organizationId, createdAt])
}

model CampaignRecipient {
  id         String          @id @default(cuid())
  campaignId String
  leadId     String?
  name       String
  phone      String?
  email      String?
  status     RecipientStatus @default(PENDING)
  channel    String?
  error      String?
  sentAt     DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
}

/// A listing posted to the firm's Facebook Page / Instagram.
model SocialPost {
  id             String   @id @default(cuid())
  organizationId String
  listingId      String
  platform       String
  status         String
  externalId     String?
  error          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([listingId, platform])
  @@index([organizationId, createdAt])
}

/// Side-by-side comparison of listings a broker sends to a client (public PDF via token).
model Comparison {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String?
  createdById    String?
  listingIds     String[]
  token          String   @unique
  opens          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}
