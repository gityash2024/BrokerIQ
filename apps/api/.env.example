# ---- Required (boot) --------------------------------------------------------
DATABASE_URL=postgresql://brokeriq:brokeriq@localhost:5432/brokeriq?schema=public
# openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_32_chars
# openssl rand -hex 32   (NEVER change after launch — encrypted credentials depend on it)
ENCRYPTION_MASTER_KEY=
# First Super Admin account (created on boot if missing)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=ChangeMe@123

# ---- URLs --------------------------------------------------------------------
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001

# ---- Optional ------------------------------------------------------------------
PORT=3000
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
JOBS_ENABLED=true
# Every third-party credential (SMTP, Cloudinary, Groq, Razorpay, WhatsApp...) is
# configured from Super Admin → Settings → Integrations. Env fallback also works:
# INTEGRATION_<KEY>_<FIELD>, e.g. INTEGRATION_GROQ_APIKEY=gsk_...
