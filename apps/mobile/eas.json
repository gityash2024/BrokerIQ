{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.20.0",
      "pnpm": "11.25.0",
      "env": { "EXPO_PUBLIC_API_URL": "https://brokeriqapi.mymultimeds.com/api" }
    },
    "development": { "extends": "base", "developmentClient": true, "distribution": "internal" },
    "preview": { "extends": "base", "distribution": "internal", "android": { "buildType": "apk" }, "channel": "preview" },
    "production": { "extends": "base", "autoIncrement": true, "android": { "buildType": "app-bundle" }, "channel": "production" }
  },
  "submit": { "production": {} }
}
