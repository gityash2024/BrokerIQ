# ==============================================================================
# BrokerIQ Monorepo Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Service
# ------------------------------------------------------------------------------
POSTGRES_USER=brokeriq
POSTGRES_PASSWORD=brokeriq_secret
POSTGRES_DB=brokeriq_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://brokeriq:brokeriq_secret@localhost:5432/brokeriq_db?schema=public

# ------------------------------------------------------------------------------
# Redis Cache & Queue Service
# ------------------------------------------------------------------------------
REDIS_PASSWORD=brokeriq_redis
REDIS_PORT=6379
REDIS_URL=redis://:brokeriq_redis@localhost:6379

# ------------------------------------------------------------------------------
# Service Ports
# ------------------------------------------------------------------------------
API_PORT=3000
ADMIN_PORT=3001
API_PREFIX=api

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_32_character_minimum_jwt_access_secret_here_12345
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_32_character_minimum_jwt_refresh_secret_here_67890
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# Master Credential Encryption (AES-256-GCM 32-byte hex key)
# ------------------------------------------------------------------------------
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_samplekey123
RAZORPAY_KEY_SECRET=sample_secret_key
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret

# ------------------------------------------------------------------------------
# WhatsApp Cloud API (Meta Business)
# ------------------------------------------------------------------------------
META_WHATSAPP_TOKEN=sample_meta_access_token
META_WHATSAPP_PHONE_NUMBER_ID=sample_phone_number_id
META_WHATSAPP_VERIFY_TOKEN=sample_webhook_verify_token

# ------------------------------------------------------------------------------
# Housing.com Real Estate Integration
# ------------------------------------------------------------------------------
HOUSING_API_KEY=sample_housing_api_key
HOUSING_WEBHOOK_SECRET=sample_housing_webhook_secret

# ------------------------------------------------------------------------------
# AI Provider (Groq)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_sample_groq_api_key
GROQ_MODEL=llama3-70b-8192

# ------------------------------------------------------------------------------
# Object Storage (DigitalOcean Spaces / S3 Compatible)
# ------------------------------------------------------------------------------
SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
SPACES_KEY=sample_spaces_key
SPACES_SECRET=sample_spaces_secret
SPACES_BUCKET=brokeriq-media
SPACES_REGION=blr1

# ------------------------------------------------------------------------------
# Push Notifications (Firebase Cloud Messaging)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=brokeriq-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@brokeriq-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Network, Security & Rate Limiting
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
THROTTLE_TTL=60
THROTTLE_LIMIT=100
